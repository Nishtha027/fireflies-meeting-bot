# Copy to .env: cp .env.example .env
# This is a dedicated Postgres instance for OUR app's data (meetings,
# transcripts, summaries, action items) - separate from Vexa's own internal
# database. Never point this at Vexa's Postgres.

POSTGRES_USER=fireflies
POSTGRES_PASSWORD=
POSTGRES_DB=fireflies_clone
POSTGRES_HOST_PORT=5433
# app/database.py builds the SQLAlchemy URL from the four values above
# (host "localhost", since the app runs outside Docker against the
# published port) - not read as a separate DATABASE_URL var, to avoid
# needing shell-style interpolation in a plain .env file.

# Vexa's API gateway (self-hosted, running separately - see docs/VEXA_SETUP.md)
VEXA_API_BASE=http://localhost:18056
VEXA_API_KEY=

# Groq API (summarization - console.groq.com). Never paste the real value
# into chat; add it directly to your own .env file.
GROQ_API_KEY=
