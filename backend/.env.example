# Copy to .env: cp .env.example .env
# This is a dedicated Postgres instance for OUR app's data (meetings,
# transcripts, summaries, action items) - separate from Vexa's own internal
# database. Never point this at Vexa's Postgres.

POSTGRES_USER=fireflies
POSTGRES_PASSWORD=
POSTGRES_DB=fireflies_clone
POSTGRES_HOST_PORT=5433
# app/database.py builds the SQLAlchemy URL from the four values above
# (host "localhost", since the app runs outside Docker against the
# published port) - not read as a separate DATABASE_URL var, to avoid
# needing shell-style interpolation in a plain .env file.

# Vexa's API gateway (self-hosted, running separately - see docs/VEXA_SETUP.md)
VEXA_API_BASE=http://localhost:18056
VEXA_API_KEY=

# Groq API (summarization - console.groq.com). Never paste the real value
# into chat; add it directly to your own .env file.
GROQ_API_KEY=

# Self-hosted faster-whisper transcription service (vexa/deploy/transcription,
# see docs/VEXA_SETUP.md) - called directly for the "Upload File" feature's
# transcription (upload_meeting.py), independent of any Vexa bot session.
# Token must match vexa/deploy/transcription/.env's own API_TOKEN.
TRANSCRIPTION_SERVICE_URL=http://localhost:8083
TRANSCRIPTION_SERVICE_TOKEN=

# ffmpeg (audio extraction for video uploads, upload_meeting.py). Only
# needed if ffmpeg isn't already on PATH - point this at the exe directly
# (e.g. after `winget install Gyan.FFmpeg`, PATH updates may not reach an
# already-running shell/process).
FFMPEG_PATH=

# Signs session JWTs. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# User accounts live in the database (users table) and are created through
# the app's /register page, gated by INVITE_CODE below - there is nothing to
# set here for them.
JWT_SECRET_KEY=

# Cookie flags - "lax"/false is correct for local http://localhost dev.
# Set COOKIE_SECURE=true in production (HTTPS). If the frontend and backend
# ever end up on different registrable domains, use COOKIE_SAMESITE=none
# (requires COOKIE_SECURE=true too - browsers reject SameSite=None without Secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origins the browser may call this API from directly (comma-separated,
# exact origins, never "*" - credentials are on). Only matters when the
# frontend calls the backend cross-origin; the default is fine for local dev.
# In production add the deployed frontend origin (see scripts/prod-env.ps1
# and docs/DEPLOYMENT.md).
CORS_ORIGINS=http://localhost:3000

# One shared code required at POST /auth/register (compared with
# secrets.compare_digest, never logged). Not a per-user/admin-managed
# system by design - share it out of band with the small group who should
# be able to register. Use a long random value, since it also travels in
# invite links (/register#invite=<code>):
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# Changing it revokes outstanding invites; existing accounts keep working.
INVITE_CODE=
